# Copy to .env to override the local defaults used by docker-compose.yml.
# Use only letters, digits, dashes and underscores in the password: it is placed in a connection string.
POSTGRES_PASSWORD=change-me-postgres-password
# At least 32 characters. Keys the HMAC that hashes card numbers.
CARD_HASHING_KEY=change-me-card-hashing-key-at-least-32-chars
